def vm_stat() -> dict[str, int]:
    out = subprocess.run(["vm_stat"], capture_output=True, text=True).stdout
    stats: dict[str, int] = {}
    for line in out.splitlines():
        m = re.match(r'"?([^"]+?)"?:\s+(\d+)', line)
        if m:
            key = m.group(1).strip().lower().replace(" ", "_").replace("-", "_")
            stats[key] = int(m.group(2))
    return stats


def swap_usage() -> dict[str, float]:
    out = subprocess.run(
        ["sysctl", "-n", "vm.swapusage"], capture_output=True, text=True
    ).stdout
    m = re.search(r"total = ([\d.]+)M\s+used = ([\d.]+)M\s+free = ([\d.]+)M", out)
    if not m:
        return {"total_mb": 0.0, "used_mb": 0.0, "free_mb": 0.0}
    return {
        "total_mb": float(m.group(1)),
        "used_mb": float(m.group(2)),
        "free_mb": float(m.group(3)),
    }


def gpu_wired_limit_mb() -> int:
    try:
        out = subprocess.run(
            ["sysctl", "-n", "iogpu.wired_limit_mb"], capture_output=True, text=True
        ).stdout.strip()
        return int(out)
    except Exception:
        return 0


def pressure_level() -> int:
    """1=normal, 2=warning, 4=critical, 0=unknown."""
    try:
        out = subprocess.run(
            ["sysctl", "-n", "kern.memorystatus_vm_pressure_level"],
            capture_output=True, text=True,
        ).stdout.strip()
        return int(out)
    except (ValueError, FileNotFoundError):
        return 0


PRESSURE_LABELS: dict[int, tuple[str, str]] = {
    1: ("Normal", "green"),
    2: ("Warning", "yellow bold"),
    4: ("Critical", "red bold"),
}


class Alerter:
    """Threshold-based alerting with per-condition debounce."""

    DEBOUNCE_S = 60.0
    SUSTAINED_TICKS = 5

    def __init__(
        self,
        swap_mb: float | None,
        swap_rate: float | None,
        on_pressure: bool,
    ) -> None:
        self.swap_mb = swap_mb
        self.swap_rate = swap_rate
        self.on_pressure = on_pressure
        self.rate_streak = 0
        self.last_pressure = 1
        self.last_fired: dict[str, float] = {}

    def _fire(self, key: str, msg: str) -> None:
        now = time.time()
        if now - self.last_fired.get(key, 0.0) < self.DEBOUNCE_S:
            return
        self.last_fired[key] = now
        sys.stderr.write(f"[llmtop alert] {msg}\n")
        sys.stderr.flush()
        safe = msg.replace('"', "'").replace("\n", " ")
        try:
            subprocess.run(
                [
                    "osascript", "-e",
                    f'display notification "{safe}" with title "llmtop"',
                ],
                check=False, capture_output=True, timeout=2,
            )
        except (FileNotFoundError, OSError, subprocess.TimeoutExpired):
            pass

    def check(self, snap: dict) -> None:
        if self.swap_mb is not None:
            used = snap["swap"]["used_mb"]
            if used > self.swap_mb:
                self._fire(
                    "swap_mb",
                    f"swap used {used:.0f} MB > {self.swap_mb:.0f} MB",
                )
        if self.swap_rate is not None:
            rate = snap["swapout_rate"]
            if rate > self.swap_rate:
                self.rate_streak += 1
                if self.rate_streak >= self.SUSTAINED_TICKS:
                    self._fire(
                        "swap_rate",
                        f"swapout sustained {rate:.0f} pages/s > "
                        f"{self.swap_rate:.0f} for {self.rate_streak} ticks",
                    )
            else:
                self.rate_streak = 0
        if self.on_pressure:
            cur = snap["pressure"]
            if cur in (2, 4) and cur != self.last_pressure:
                lbl = PRESSURE_LABELS.get(cur, ("?", ""))[0]
                self._fire("pressure", f"memory pressure → {lbl}")
            self.last_pressure = cur


_PROC_GONE = (psutil.NoSuchProcess, psutil.AccessDenied, psutil.ZombieProcess)


class ProcScanner:
    """Filter-matching process list with a fast/slow path.

    Full ``process_iter`` rescan every ``full_scan_interval`` seconds; between
    rescans only ``memory_info`` is re-polled for cached PIDs. Names and
    cmdlines rarely change, so this avoids walking the full process table on
    every tick.
    """

    def __init__(self, patterns: list[str], full_scan_interval: float = 5.0) -> None:
        self.pats = [p.lower() for p in patterns]
        self.full_scan_interval = full_scan_interval
        self.last_full = 0.0
        self.cache: dict[int, dict] = {}

    def scan(self) -> list[dict]:
        now = time.time()
        if now - self.last_full >= self.full_scan_interval:
            self._full_rescan()
            self.last_full = now
        else:
            self._refresh_mem()
        return sorted(self.cache.values(), key=lambda x: -x["rss"])

    def _full_rescan(self) -> None:
        new_cache: dict[int, dict] = {}
        for p in psutil.process_iter(["pid", "name", "cmdline", "memory_info"]):
            try:
                name = p.info["name"] or ""
                cmd = " ".join(p.info["cmdline"] or []).replace("\n", " ").replace("\r", " ")
                if not any(pat in (name + " " + cmd).lower() for pat in self.pats):
                    continue
                mi = p.info["memory_info"]
                if mi is None:
                    continue
                new_cache[p.info["pid"]] = {
                    "pid": p.info["pid"],
                    "name": name,
                    "cmd": cmd,
                    "rss": mi.rss,
                    "vms": mi.vms,
                }
            except _PROC_GONE:
                continue
        self.cache = new_cache

    def _refresh_mem(self) -> None:
        for pid in list(self.cache):
            try:
                mi = psutil.Process(pid).memory_info()
                self.cache[pid]["rss"] = mi.rss
                self.cache[pid]["vms"] = mi.vms
            except _PROC_GONE:
                self.cache.pop(pid, None)


_MODEL_FLAG_RE = re.compile(
    r"--(?:model|hf-repo|model[-_]path|adapter[-_]path)(?:[= ]+|\s+)(\S+)"
)
_MODEL_FILE_RE = re.compile(r"(\S+\.(?:gguf|safetensors|mlx))", re.IGNORECASE)


def extract_model_from_cmdline(cmd: str) -> tuple[str, str | None] | None:
    """Returns (display_name, local_path_or_None). Path is None for HF repos."""
    if not cmd:
        return None
    m = _MODEL_FLAG_RE.search(cmd)
    if m:
        v = m.group(1).strip("\"'")
        if v.endswith((".gguf", ".safetensors", ".mlx")):
            return Path(v).name, v
        return v, None
    m = _MODEL_FILE_RE.search(cmd)
    if m:
        return Path(m.group(1)).name, m.group(1)
    return None


def _file_size(path: str | None) -> int:
    if not path:
        return 0
    try:
        p = Path(path)
        if p.is_file():
            return p.stat().st_size
        if p.is_dir():
            return sum(
                f.stat().st_size for f in p.rglob("*")
                if f.is_file() and f.suffix in (".gguf", ".safetensors", ".mlx", ".bin")
            )
    except OSError:
        pass
    return 0


def ollama_models() -> list[dict]:
    """Active ollama models from local API. Empty list if ollama isn't running."""
    try:
        with urllib.request.urlopen(
            "http://127.0.0.1:11434/api/ps", timeout=0.5
        ) as r:
            data = json.loads(r.read())
        return data.get("models", []) or []
    except (urllib.error.URLError, TimeoutError, ConnectionError, OSError, ValueError):
        return []


def omlx_models() -> list[dict]:
    """Loaded omlx models via authenticated /v1/models/status. Empty if not running."""
    settings_path = Path.home() / ".omlx" / "settings.json"
    try:
        settings = json.loads(settings_path.read_text())
    except (OSError, json.JSONDecodeError):
        return []
    api_key = settings.get("auth", {}).get("api_key", "")
    port = settings.get("server", {}).get("port", 8000)
    if not api_key:
        return []
    try:
        req = urllib.request.Request(
            f"http://127.0.0.1:{port}/v1/models/status",
            headers={"Authorization": f"Bearer {api_key}"},
        )
        with urllib.request.urlopen(req, timeout=0.5) as r:
            data = json.loads(r.read())
    except (urllib.error.URLError, TimeoutError, ConnectionError, OSError, ValueError):
        return []
    return [m for m in data.get("models", []) if m.get("loaded")]


def lmstudio_models() -> list[dict]:
    """Loaded LM Studio models via /api/v0/models. Empty if not running.

    Uses the LM Studio 0.3.x REST endpoint which exposes a ``state`` field; we
    only return entries with ``state == "loaded"``. Port can be overridden via
    the ``LMSTUDIO_PORT`` env var (default 1234).
    """
    port = os.environ.get("LMSTUDIO_PORT", "1234")
    try:
        with urllib.request.urlopen(
            f"http://127.0.0.1:{port}/api/v0/models", timeout=0.5
        ) as r:
            data = json.loads(r.read())
    except (urllib.error.URLError, TimeoutError, ConnectionError, OSError, ValueError):
        return []
    items = data.get("data") or data.get("models") or []
    return [m for m in items if m.get("state") == "loaded"]


_size_cache: dict[str, int] = {}


def model_id_from_path(path: Path) -> str | None:
    """Derive a stable model id from a weight-file path, or None if it can't
    be attributed to a model (e.g. lives in a content-addressable shard dir).

    Handles HF cache (``models--org--repo/snapshots/<hash>/<file>``),
    omlx-style flat dirs, and single-file ggufs.
    """
    for ancestor in path.parents:
        if ancestor.name.startswith("models--"):
            return ancestor.name.removeprefix("models--").replace("--", "/")
    parent = path.parent
    parent_name = parent.name
    if not parent_name:
        return None
    is_hex = all(c in "0123456789abcdef" for c in parent_name.lower())
    if is_hex and len(parent_name) <= 4:
        return None
    if parent_name == "snapshots" or (is_hex and len(parent_name) >= 32):
        return parent.parent.name
    if path.suffix.lower() == ".gguf":
        return path.name
    return parent_name


def _lsof_paths(pid: int) -> list[str]:
    """Files opened or mmap'd by ``pid``. Uses ``lsof`` because on macOS
    ``psutil.Process.open_files()`` only reports currently-open fds, missing
    mmap'd weights (MLX/safetensors typically open → mmap → close)."""
    try:
        out = subprocess.run(
            ["lsof", "-p", str(pid), "-Fn"],
            capture_output=True, text=True, timeout=2,
        ).stdout
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return []
    return [ln[1:] for ln in out.splitlines() if ln.startswith("n/")]


def detect_open_model_files(p: dict) -> list[dict]:
    """Group a process's open weight files by model id."""
    paths = _lsof_paths(p["pid"])
    if not paths:
        try:
            proc = psutil.Process(p["pid"])
            paths = [f.path for f in proc.open_files()]
        except (psutil.NoSuchProcess, psutil.AccessDenied, psutil.ZombieProcess):
            return []

    by_model: dict[str, int] = {}
    for path_s in set(paths):
        path = Path(path_s)
        if path.suffix.lower() not in MODEL_EXTS:
            continue
        try:
            size = path.stat().st_size
        except OSError:
            continue
        if size < 50 * 1024 * 1024:
            continue
        mid = model_id_from_path(path)
        if mid is None:
            continue
        by_model[mid] = by_model.get(mid, 0) + size

    if not by_model:
        return []

    total = sum(by_model.values())
    rss = p["rss"]
    return [
        {
            "source": p["name"],
            "model": mid,
            "size": size,
            "resident": min(size, rss * size // total),
            "proc": p["name"],
            "pid": p["pid"],
        }
        for mid, size in by_model.items()
    ]


def collect_models(
    procs: list[dict],
    ollama: list[dict],
    omlx: list[dict],
    lmstudio: list[dict],
) -> list[dict]:
    """Unified list of resident models from ollama API + omlx API + LM Studio
    API + per-proc open files (authoritative) + cmdline (fallback)."""
    out: list[dict] = []

    for m in ollama:
        out.append(
            {
                "source": "ollama",
                "model": m.get("name") or m.get("model") or "?",
                "size": int(m.get("size") or 0),
                "resident": int(m.get("size_vram") or m.get("size") or 0),
                "proc": "ollama",
                "pid": "",
            }
        )

    for m in omlx:
        size = int(m.get("estimated_size") or 0)
        out.append(
            {
                "source": "omlx",
                "model": m.get("id") or "?",
                "size": size,
                "resident": size,
                "proc": "omlx",
                "pid": "",
            }
        )

    for m in lmstudio:
        size = int(m.get("size") or m.get("file_size") or 0)
        out.append(
            {
                "source": "lmstudio",
                "model": m.get("id") or "?",
                "size": size,
                "resident": size,
                "proc": "lmstudio",
                "pid": "",
            }
        )

    by_model: dict[str, dict] = {}

    for p in procs:
        detected = detect_open_model_files(p)
        if detected:
            for entry in detected:
                cur = by_model.get(entry["model"])
                if cur is None or entry["resident"] > cur["resident"]:
                    by_model[entry["model"]] = entry
            continue

        ext = extract_model_from_cmdline(p["cmd"])
        if not ext:
            continue
        mid, path = ext
        if path is not None and path not in _size_cache:
            _size_cache[path] = _file_size(path)
        size = _size_cache.get(path, 0) if path else 0
        cur = by_model.get(mid)
        if cur is None or p["rss"] > cur["resident"]:
            by_model[mid] = {
                "source": p["name"],
                "model": mid,
                "size": size,
                "resident": p["rss"],
                "proc": p["name"],
                "pid": p["pid"],
            }

    out.extend(by_model.values())
    return sorted(out, key=lambda x: -max(x["size"], x["resident"]))


def fmt_bytes(b: float) -> str:
    for unit in ("B", "KB", "MB", "GB"):
        if abs(b) < 1024:
            return f"{b:.1f}{unit}"
        b /= 1024
    return f"{b:.1f}TB"


def pages_to_bytes(pages: int) -> int:
    return pages * PAGE_SIZE


def collect(prev: dict, dt: float) -> dict:
    vm = vm_stat()
    swap = swap_usage()

    def rate(key: str) -> float:
        cur = vm.get(key, 0)
        prv = prev["vm"].get(key, cur)
        return max(0.0, (cur - prv) / dt) if dt > 0 else 0.0

    return {
        "ts": time.time(),
        "vm": vm,
        "swap": swap,
        "swapin_rate": rate("swapins"),
        "swapout_rate": rate("swapouts"),
        "compress_rate": rate("pages_compressed"),
        "decompress_rate": rate("pages_decompressed"),
        "pageout_rate": rate("pageouts"),
        "pressure": pressure_level(),
        "gpu_wired_limit_mb": gpu_wired_limit_mb(),
    }


def build_layout(
    snap: dict,
    procs: list[dict],
    models: list[dict],
    history: dict[str, Deque[float]] | None = None,
    panes: set[str] | None = None,
) -> Layout:
    panes = panes if panes is not None else set(PANE_NAMES)
    vm = snap["vm"]
    swap = snap["swap"]
    total = psutil.virtual_memory().total

    wired_b = pages_to_bytes(vm.get("pages_wired_down", 0))
    active_b = pages_to_bytes(vm.get("pages_active", 0))
    inactive_b = pages_to_bytes(vm.get("pages_inactive", 0))
    free_b = pages_to_bytes(vm.get("pages_free", 0))
    compressed_b = pages_to_bytes(
        vm.get("pages_occupied_by_compressor", vm.get("pages_used_by_compressor", 0))
    )
    swap_color = (
        "red bold" if swap["used_mb"] > 500
        else "yellow" if swap["used_mb"] > 0
        else "green"
    )
    rate_color = "red bold" if snap["swapout_rate"] > 0 else "green"
    gpu_str = (
        f"{snap['gpu_wired_limit_mb']} MB"
        if snap["gpu_wired_limit_mb"] > 0
        else "auto (~75%)"
    )

    sys_t = Table.grid(padding=(0, 2), expand=True)
    for _ in range(12):
        sys_t.add_column()
    label = lambda s: f"[bold cyan]{s}[/]"
    sys_t.add_row(
        label("RAM"), fmt_bytes(total),
        label("Wired"), fmt_bytes(wired_b),
        label("Active"), fmt_bytes(active_b),
        label("Inactive"), fmt_bytes(inactive_b),
        label("Compressed"), fmt_bytes(compressed_b),
        label("Free"), fmt_bytes(free_b),
    )
    sys_t.add_row(
        label("Swap"),
        f"[{swap_color}]{swap['used_mb']:.0f}/{swap['total_mb']:.0f}MB[/]",
        label("Out/s"),
        f"[{rate_color}]{snap['swapout_rate']:.1f}[/]",
        label("In/s"), f"{snap['swapin_rate']:.1f}",
        label("Σ out"), f"{vm.get('swapouts', 0):,}",
        label("Σ in"), f"{vm.get('swapins', 0):,}",
        label("iogpu wired"), gpu_str,
    )

    plabel, pcolor = PRESSURE_LABELS.get(snap["pressure"], ("?", "dim"))
    purgeable_b = pages_to_bytes(vm.get("pages_purgeable", 0))
    pageout_mbps = snap["pageout_rate"] * PAGE_SIZE / (1024 * 1024)
    compress_mbps = snap["compress_rate"] * PAGE_SIZE / (1024 * 1024)
    decompress_mbps = snap["decompress_rate"] * PAGE_SIZE / (1024 * 1024)
    pageout_color = "red bold" if pageout_mbps > 0 else "green"

    if history:
        out_vals = history.get("swapout", ())
        cmp_vals = history.get("compress", ())
        out_peak = max(out_vals) if out_vals else 0.0
        cmp_peak = max(cmp_vals) if cmp_vals else 0.0
        out_color = "red bold" if out_peak > 0 else "dim"
        cmp_color = "yellow" if cmp_peak > 0 else "dim"
        swap_pk_s = f"[{out_color}]{out_peak:.0f} pg/s[/]"
        cmp_pk_s = f"[{cmp_color}]{cmp_peak:.1f} MB/s[/]"
        window_s = f"{len(out_vals)} pts"
    else:
        swap_pk_s = cmp_pk_s = window_s = "[dim]—[/]"

    pressure_t = Table(expand=True, show_edge=False, box=box.SIMPLE_HEAD)
    for col_name in (
        "Pressure", "Compress", "Decompress", "Purgeable", "Pageout",
        "Swap pk", "Cmp pk", "Window",
    ):
        pressure_t.add_column(col_name, justify="right", no_wrap=True)
    pressure_t.add_row(
        f"[{pcolor}]{plabel}[/]",
        f"{compress_mbps:.1f} MB/s",
        f"{decompress_mbps:.1f} MB/s",
        fmt_bytes(purgeable_b),
        f"[{pageout_color}]{pageout_mbps:.1f} MB/s[/]",
        swap_pk_s,
        cmp_pk_s,
        window_s,
    )

    models_t = Table(
        expand=True, title_style="bold green",
        show_edge=False, box=box.SIMPLE_HEAD,
    )
    models_t.add_column("Source", justify="right", style="green", no_wrap=True)
    models_t.add_column("Model", justify="right", style="bold")
    models_t.add_column("Size", justify="right", style="cyan")
    models_t.add_column("Resident", justify="right", style="bold yellow")
    models_t.add_column("%", justify="right")
    models_t.add_column("Process", justify="right", style="dim", no_wrap=True)
    models_t.add_column("PID", justify="right", style="dim")
    if models:
        shown = models[:10]
        for m in shown:
            size = m["size"]
            res = m["resident"]
            pct = (res / size * 100) if size > 0 else 0
            pct_color = (
                "green" if pct >= 90 else "yellow" if pct >= 50 else "red"
            ) if size > 0 else "dim"
            pct_s = f"[{pct_color}]{pct:5.1f}%[/]" if size > 0 else "[dim]—[/]"
            models_t.add_row(
                m["source"],
                m["model"],
                fmt_bytes(size) if size > 0 else "[dim]—[/]",
                fmt_bytes(res),
                pct_s,
                m["proc"],
                str(m["pid"]) if m["pid"] != "" else "—",
            )
        if len(shown) >= 2:
            tot_size = sum(m["size"] for m in shown)
            tot_res = sum(m["resident"] for m in shown)
            ram_pct = (tot_res / total * 100) if total > 0 else 0
            ram_color = (
                "red bold" if ram_pct >= 70
                else "yellow" if ram_pct >= 40
                else "green"
            )
            models_t.add_section()
            models_t.add_row(
                "[bold]TOTAL[/]",
                "",
                fmt_bytes(tot_size) if tot_size > 0 else "[dim]—[/]",
                f"[bold]{fmt_bytes(tot_res)}[/]",
                f"[{ram_color}]{ram_pct:5.1f}% RAM[/]",
                "",
                "",
            )
    else:
        models_t.add_row(
            "—", "[dim](no models detected — check ollama API or proc filters)[/]",
            "", "", "", "", "",
        )

    proc_t = Table(expand=True, show_edge=False, box=box.SIMPLE_HEAD)
    proc_t.add_column("PID", justify="right", style="dim", no_wrap=True, width=7)
    proc_t.add_column(
        "Name", justify="right", style="cyan",
        no_wrap=True, min_width=14, overflow="ellipsis",
    )
    proc_t.add_column("RSS", justify="right", style="bold", width=9)
    proc_t.add_column("VMS", justify="right", style="dim", width=9)
    proc_t.add_column("Cmd", justify="right", overflow="ellipsis", no_wrap=True, ratio=2)
    for p in procs[:20]:
        proc_t.add_row(
            str(p["pid"]),
            p["name"],
            fmt_bytes(p["rss"]),
            fmt_bytes(p["vms"]),
            p["cmd"],
        )
    if not procs:
        proc_t.add_row("—", "(none)", "", "", "")

    footer = Text("ctrl-c to quit", justify="right", style="dim")
    models_size = max(5, min(13, len(models) + 5))

    title = lambda s: f"[bold white]{s}[/]"
    pad = (0, 1, 0, 1)
    specs: list[tuple[str, Panel, int | None]] = [
        ("system", Panel(sys_t, title=title("System Memory"),
                         border_style="cyan", padding=pad), 5),
        ("pressure", Panel(pressure_t, title=title("Memory Pressure"),
                           border_style="yellow", padding=pad), 6),
        ("models", Panel(models_t, title=title("Active Models"),
                         border_style="green", padding=pad), models_size),
        ("procs", Panel(proc_t, title=title("Matching Processes"),
                        border_style="magenta", padding=pad), None),
    ]
    shown = [s for s in specs if s[0] in panes]
    children = []
    for i, (name, panel, size) in enumerate(shown):
        is_last = i == len(shown) - 1
        if is_last or size is None:
            children.append(Layout(panel, name=name))
        else:
            children.append(Layout(panel, size=size, name=name))
    children.append(Layout(footer, size=1, name="footer"))
    layout = Layout()
    layout.split_column(*children)
    return layout


def jsonl_payload(snap: dict, procs: list[dict], models: list[dict]) -> dict:
    vm = snap["vm"]
    swap = snap["swap"]
    compressed_b = pages_to_bytes(
        vm.get("pages_occupied_by_compressor", vm.get("pages_used_by_compressor", 0))
    )
    ts = datetime.fromtimestamp(snap["ts"]).isoformat(timespec="seconds")
    return {
        "ts": ts,
        "wired_mb": pages_to_bytes(vm.get("pages_wired_down", 0)) / 1e6,
        "active_mb": pages_to_bytes(vm.get("pages_active", 0)) / 1e6,
        "compressed_mb": compressed_b / 1e6,
        "free_mb": pages_to_bytes(vm.get("pages_free", 0)) / 1e6,
        "swap_used_mb": swap["used_mb"],
        "swapouts_total": vm.get("swapouts", 0),
        "swapins_total": vm.get("swapins", 0),
        "swapin_rate": round(snap["swapin_rate"], 2),
        "swapout_rate": round(snap["swapout_rate"], 2),
        "pressure": snap["pressure"],
        "gpu_wired_limit_mb": snap["gpu_wired_limit_mb"],
        "procs": [
            {
                "pid": p["pid"],
                "name": p["name"],
                "rss_mb": round(p["rss"] / 1e6, 1),
            }
            for p in procs[:8]
        ],
        "models": [
            {
                "source": m["source"],
                "model": m["model"],
                "size_mb": round(m["size"] / 1e6, 1),
                "resident_mb": round(m["resident"] / 1e6, 1),
                "pid": m["pid"],
            }
            for m in models
        ],
    }


def log_row(
    snap: dict, procs: list[dict], models: list[dict], csv_w, jsonl_f
) -> None:
    vm = snap["vm"]
    swap = snap["swap"]
    compressed_b = pages_to_bytes(
        vm.get("pages_occupied_by_compressor", vm.get("pages_used_by_compressor", 0))
    )
    top = procs[0] if procs else {"pid": "", "name": "", "rss": 0}
    ts = datetime.fromtimestamp(snap["ts"]).isoformat(timespec="seconds")

    if csv_w:
        csv_w.writerow(
            [
                ts,
                f"{pages_to_bytes(vm.get('pages_wired_down', 0)) / 1e6:.1f}",
                f"{pages_to_bytes(vm.get('pages_active', 0)) / 1e6:.1f}",
                f"{compressed_b / 1e6:.1f}",
                f"{pages_to_bytes(vm.get('pages_free', 0)) / 1e6:.1f}",
                f"{swap['used_mb']:.1f}",
                f"{swap['total_mb']:.1f}",
                vm.get("swapins", 0),
                vm.get("swapouts", 0),
                f"{snap['swapin_rate']:.2f}",
                f"{snap['swapout_rate']:.2f}",
                top["pid"],
                top["name"],
                f"{top['rss'] / 1e6:.1f}",
            ]
        )
    if jsonl_f:
        jsonl_f.write(json.dumps(jsonl_payload(snap, procs, models)) + "\n")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("-i", "--interval", type=float, default=1.0, help="seconds (default 1)")
    ap.add_argument(
        "-m", "--match", action="append", default=[],
        help=f"process name/cmd substring (repeatable; default: {','.join(DEFAULT_PATTERNS)})",
    )
    ap.add_argument("--log", type=Path, help="append CSV log to file")
    ap.add_argument("--jsonl", type=Path, help="append JSONL log to file")
    ap.add_argument("--no-tui", action="store_true", help="headless mode: only log, no UI")
    ap.add_argument("--once", action="store_true",
                    help="take one sample, print JSON to stdout, exit")
    ap.add_argument("--proc-scan-interval", type=float, default=5.0,
                    help="seconds between full process_iter rescans (default 5)")
    ap.add_argument("--alert-swap-mb", type=float, default=None, metavar="N",
                    help="notify when swap used exceeds N MB")
    ap.add_argument("--alert-swap-rate", type=float, default=None, metavar="N",
                    help="notify when swapout rate (pages/s) stays above N for ~5 ticks")
    ap.add_argument("--alert-pressure", action="store_true",
                    help="notify on transition into Warning/Critical pressure")
    ap.add_argument(
        "--pane", action="append", default=[], choices=list(PANE_NAMES),
        metavar="NAME",
        help=f"show only this pane (repeatable; choices: {', '.join(PANE_NAMES)}; default: all)",
    )
    args = ap.parse_args()

    patterns = args.match or DEFAULT_PATTERNS
    panes = set(args.pane) if args.pane else set(PANE_NAMES)
    console = Console()

    csv_file = csv_w = None
    if args.log:
        new = not args.log.exists()
        csv_file = args.log.open("a", newline="")
        csv_w = csv.writer(csv_file)
        if new:
            csv_w.writerow(
                [
                    "ts", "wired_mb", "active_mb", "compressed_mb", "free_mb",
                    "swap_used_mb", "swap_total_mb", "swapins_total", "swapouts_total",
                    "swapin_rate", "swapout_rate", "top_pid", "top_name", "top_rss_mb",
                ]
            )
    jsonl_file = args.jsonl.open("a") if args.jsonl else None

    signal.signal(signal.SIGINT, lambda *_: sys.exit(0))

    scanner = ProcScanner(patterns, full_scan_interval=args.proc_scan_interval)
    alerter = Alerter(
        swap_mb=args.alert_swap_mb,
        swap_rate=args.alert_swap_rate,
        on_pressure=args.alert_pressure,
    )
    history: dict[str, Deque[float]] = {
        "swapout": deque(maxlen=HIST_LEN),
        "compress": deque(maxlen=HIST_LEN),
        "pageout": deque(maxlen=HIST_LEN),
    }

    prev = {"ts": time.time(), "vm": vm_stat()}

    def tick() -> tuple[dict, list[dict], list[dict]]:
        nonlocal prev
        time.sleep(args.interval)
        now_ts = time.time()
        dt = now_ts - prev["ts"]
        snap = collect(prev, dt)
        procs = scanner.scan()
        models = collect_models(
            procs, ollama_models(), omlx_models(), lmstudio_models()
        )
        log_row(snap, procs, models, csv_w, jsonl_file)
        if csv_file:
            csv_file.flush()
        if jsonl_file:
            jsonl_file.flush()
        history["swapout"].append(snap["swapout_rate"])
        history["compress"].append(snap["compress_rate"] * PAGE_SIZE / (1024 * 1024))
        history["pageout"].append(snap["pageout_rate"])
        alerter.check(snap)
        prev = {"ts": snap["ts"], "vm": snap["vm"]}
        return snap, procs, models

    try:
        if args.once:
            snap, procs, models = tick()
            sys.stdout.write(json.dumps(jsonl_payload(snap, procs, models)) + "\n")
            sys.stdout.flush()
            return 0
        if args.no_tui:
            console.print(
                f"[dim]logging every {args.interval}s — ctrl-c to stop[/dim]"
            )
            while True:
                snap, procs, models = tick()
                top = procs[0] if procs else {"name": "-", "rss": 0}
                model_str = (
                    " ".join(
                        f"{m['model']}({fmt_bytes(m['resident'])}/{fmt_bytes(m['size'])})"
                        if m["size"] else f"{m['model']}({fmt_bytes(m['resident'])})"
                        for m in models[:3]
                    )
                    or "-"
                )
                console.print(
                    f"{datetime.now():%H:%M:%S} "
                    f"swap={snap['swap']['used_mb']:7.1f}MB "
                    f"out/s={snap['swapout_rate']:5.1f} "
                    f"in/s={snap['swapin_rate']:5.1f} "
                    f"top={top['name']}({fmt_bytes(top['rss'])}) "
                    f"models={model_str}"
                )
        else:
            with Live(console=console, refresh_per_second=4, screen=True) as live:
                while True:
                    snap, procs, models = tick()
                    live.update(build_layout(snap, procs, models, history, panes))
    finally:
        if csv_file:
            csv_file.close()
        if jsonl_file:
            jsonl_file.close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
